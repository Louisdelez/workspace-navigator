{
  "name": "workspace-navigator",
  "version": "0.1.0",
  "description": "Workspace Navigator - Cross-platform desktop app combining web browser, Markdown editor, and AI assistant",
  "main": "dist/main/main/index.js",
  "author": "Workspace Navigator Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run build:main && electron dist/main/main/index.js\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:all": "npm run build && electron-builder -mwl",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.2",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/core": "^7.17.2",
    "@milkdown/ctx": "^7.17.2",
    "@milkdown/plugin-listener": "^7.17.2",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/preset-commonmark": "^7.17.2",
    "@milkdown/preset-gfm": "^7.17.2",
    "@milkdown/react": "^7.17.2",
    "@milkdown/theme-nord": "^7.17.2",
    "better-sqlite3": "^9.2.2",
    "katex": "^0.16.27",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "icon-gen": "^5.0.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.56.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.4",
    "vite-plugin-electron": "^0.28.1",
    "vitest": "^1.6.1",
    "wait-on": "^7.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.navigateur.workspace",
    "electronDownload": {
      "customDir": "v30.0.0"
    },
    "productName": "Workspace Navigator",
    "copyright": "Copyright © 2025 Workspace Navigator Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/",
        "to": ".",
        "filter": [
          "icon.*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/app.ico",
      "publisherName": "Workspace Navigator Team",
      "legalTrademarks": "",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/app.ico",
      "uninstallerIcon": "build/app.ico",
      "installerHeaderIcon": "build/app.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workspace Navigator",
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": 1033
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/app.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "minimumSystemVersion": "10.15.0",
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2025 Workspace Navigator Team",
        "CFBundleShortVersionString": "0.1.0",
        "NSRequiresAquaSystemAppearance": false
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "notarize": false
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "backgroundColor": "#f8fafc",
      "iconSize": 80,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 400
      },
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterSign": "scripts/notarize.js",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Office;Utility;Development;",
      "maintainer": "Workspace Navigator Team <support@workspace-navigator.dev>",
      "vendor": "Workspace Navigator",
      "synopsis": "Workspace Navigator - Combined browser, editor, and AI assistant",
      "description": "A cross-platform desktop application combining web browser, Markdown editor, and AI assistant in a unified workspace. Features include multi-tab web browsing, Markdown note editing with live preview, integrated AI assistants (ChatGPT, Claude, Gemini), workspace organization with folders and tags, and session persistence.",
      "executableName": "workspace-navigator",
      "desktop": {
        "Name": "Workspace Navigator",
        "GenericName": "Productivity Suite",
        "Comment": "Browser, Editor, and AI Assistant in one app",
        "Keywords": "browser;editor;markdown;ai;workspace;notes;productivity",
        "StartupWMClass": "workspace-navigator",
        "MimeType": "text/markdown;text/x-markdown;x-scheme-handler/http;x-scheme-handler/https"
      },
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ]
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "libxss1",
        "libasound2",
        "libsecret-1-0",
        "libappindicator3-1"
      ],
      "recommends": [
        "libgconf-2-4"
      ],
      "priority": "optional",
      "afterInstall": "scripts/linux/postinst.sh",
      "afterRemove": "scripts/linux/postrm.sh"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
